# Optional settings for development. Copy to .env (ignored by git).
# Narcisse needs no secret to run.

# Where Narcisse keeps its data (default: the OS data directory, e.g. ~/.local/share/narcisse).
# NARCISSE_DATA_DIR=

# Port of `narcisse serve` (default: 80 when free, so that the address carries no port; else 8765).
# NARCISSE_PORT=
